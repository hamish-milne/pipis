{
  "name": "pipis",
  "version": "0.1.0",
  "description": "A tiny JSX framework with no virtual DOM and no re-rendering: components run once and reactive values bind straight to DOM nodes.",
  "license": "MIT",
  "author": "Neofox Solutions LLP and Hamish Milne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neofox-solutions/pipis.git"
  },
  "homepage": "https://github.com/neofox-solutions/pipis#readme",
  "bugs": {
    "url": "https://github.com/neofox-solutions/pipis/issues"
  },
  "keywords": [
    "jsx",
    "reactive",
    "ui",
    "dom",
    "no-virtual-dom",
    "tiny"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/pipis/index.ts",
    "./jsx-runtime": "./src/pipis/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/pipis/jsx-dev-runtime.ts"
  },
  "devDependencies": {
    "@preact/signals-core": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-baseline-js": "catalog:",
    "highlight.js": "catalog:",
    "jotai": "catalog:",
    "jsdom": "catalog:",
    "marked": "catalog:",
    "nanostores": "catalog:",
    "oxfmt": "catalog:",
    "playwright": "catalog:",
    "redux": "catalog:",
    "rolldown": "catalog:",
    "rxjs": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "valtio": "catalog:",
    "vite-plus": "catalog:",
    "xstate": "catalog:",
    "zustand": "catalog:"
  }
}
