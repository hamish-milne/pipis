{
  // The declarations the package ships, one `.d.ts` per library module. `tools/pack.ts` emits them; nothing else uses this.
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "out/types",
    "rootDir": "src/pipis",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  }
}
